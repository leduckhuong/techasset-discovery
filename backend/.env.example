# ---- TechAsset Discovery Backend ----

# API key bảo vệ webhook /api/cve/push (con bot phải gửi header "X-API-Key").
# Để trống nếu chưa cần auth (mặc định: không bắt buộc).
CVE_PUSH_API_KEY=

# Đường dẫn file SQLite (mặc định: backend/data/techasset.db)
DB_PATH=./data/techasset.db

# Host/Port cho API server
HOST=0.0.0.0
PORT=8000

# Timezone cho lịch quét định kỳ (cron)
SCHEDULER_TZ=Asia/Ho_Chi_Minh

# User-Agent dùng khi quét
SCANNER_USER_AGENT=Mozilla/5.0 (compatible; TechAsset-Scanner/2.0; Tech-Discovery-Engine)

# ---- Telegram bot (đẩy CVE alerts vào nhóm) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # nhóm FEED chứa tin CVE — listener chỉ ĐỌC
TELEGRAM_REPORT_CHAT_ID=       # nhóm nhận kết quả phân tích (bỏ trống = dùng TELEGRAM_CHAT_ID)

# ---- AI engine (OpenAI-compatible) phân tích CVE ----
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=300

# ---- Bảo mật: login (user + password + TOTP 2FA). Bỏ trống ADMIN_PASSWORD = tắt auth ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TOTP_SECRET=
SESSION_SECRET=change-me
SESSION_HOURS=12

# ---- TLS (HTTPS): mount certs + set 2 đường dẫn ----
TLS_CERTFILE=
TLS_KEYFILE=

# ---- httpx tech-detect khi quét tech (version chi tiết hơn) ----
HTTPX_TECH_DETECT=1
